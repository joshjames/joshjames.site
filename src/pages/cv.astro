	<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-[#334155] pb-4 mb-6">
		<div>
			<h1>cat /var/log/professional_history.log</h1>
		</div>
		<!-- Hard Copy Asset Export Handles -->
		<div class="mt-4 sm:mt-0 flex space-x-3 font-mono text-xs">
			<a href="/files/josh.james.cv.pdf" download class="px-3 py-1.5 bg-[#1e293b] border border-[#334155] rounded text-[#38bdf8] hover:border-[#38bdf8] transition-colors">
				[PDF Export]
			</a>
			<a href="/files/josh.james.cv.docx" download class="px-3 py-1.5 bg-[#1e293b] border border-[#334155] rounded text-[#64748b] hover:border-[#cbd5e1] transition-colors">
				[DOCX Copy]
